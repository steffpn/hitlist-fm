<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome status-bar notification icon: simplified hitlist.fm rotation gauge.
     Android renders only the alpha channel, so everything is plain white. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- Gauge arc (270°) -->
    <group android:rotation="135" android:pivotX="12" android:pivotY="12">
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:trimPathStart="0"
            android:trimPathEnd="0.75"
            android:pathData="M4,12 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0" />
    </group>
    <!-- Needle -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M12,12 L17.1,9" />
    <!-- Hub -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,12 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0" />
</vector>
