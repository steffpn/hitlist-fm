<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. `development` provisions the sandbox APNs
	     environment for Debug/TestFlight; Xcode/App Store promote it to production
	     automatically for App Store distribution builds. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
