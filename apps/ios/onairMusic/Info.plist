<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE = YES).
	     Registers the hitlist:// custom scheme used by the Stripe
	     Checkout/Portal return flow (hitlist://subscription/...). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>fm.hitlist.pro</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>hitlist</string>
			</array>
		</dict>
	</array>
	<!-- Background audio: keeps snippet playback alive and lock-screen / Control Center
	     transport controls working when the app is backgrounded or the screen is locked
	     (AudioPlayerManager sets AVAudioSession .playback + MPNowPlayingInfoCenter). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
