# Local development env. Copy to .env and fill in. Never commit real secrets.
DATABASE_URL=postgresql://mfm:mfm_local@localhost:5432/myfuckingmusic
REDIS_URL=redis://localhost:6379

# ACRCloud — broadcast monitoring console (https://console.acrcloud.com).
# Required for /admin/acrcloud-search and any feature that calls the ACR REST API.
# Stream IDs themselves live in the Station table (acrcloudStreamId column).
ACRCLOUD_API_TOKEN=

# Cloudflare R2 — required only when SNIPPETS_ENABLED=true.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# JWT — generate with: openssl rand -hex 32
# JWT_SECRET=

# First-time admin bootstrap (only used when the users table is empty).
# Leave unset in production — create the first admin via DB instead.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
